# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
# Optional. Local dev uses 3000 via npm run dev; Cloud Run / default is 8080.
PORT=3000

# --- ClickUp ---
CLICKUP_API_KEY=pk_your_clickup_api_token
CLICKUP_LIST_ID=123456789
# Status name when reopening a task (default: open)
CLICKUP_REOPEN_STATUS=open

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
# Local dev only: skips Slack HMAC verification (ignored when NODE_ENV=production)
# SKIP_SLACK_VERIFY=true
SLACK_CHANNEL_ID=C01234567890
SLACK_ALERTS_CHANNEL_ID=C09876543210
# Optional. Default: @itopsteam
ITOPS_TEAM_TAG=@itopsteam
# Optional. JSON map Slack user ID -> ClickUp assignee user id (number)
# SLACK_TO_CLICKUP_USER_MAP={"U0123456789":12345678}

# --- Google Sheets webhook (Apps Script -> /api/sheets-webhook) ---
SHEETS_WEBHOOK_SECRET=your_shared_webhook_secret

# --- Upstash Redis (thread mapping, reopen state). Use REST URL + token or legacy names. ---
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# UPSTASH_REDIS_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_TOKEN=your_upstash_token
